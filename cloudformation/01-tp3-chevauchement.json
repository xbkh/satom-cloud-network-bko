{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "TP 3 - test de chevauchement CIDR dans le VPC de production",
  "Parameters": {
    "VpcId": {"Type": "AWS::EC2::VPC::Id"},
    "Equipe": {"Type": "String", "MinLength": 1}
  },
  "Resources": {
    "SubnetChevauchant": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {"Ref": "VpcId"},
        "CidrBlock": "10.0.1.128/25",
        "AvailabilityZone": "eu-north-1a",
        "Tags": [
          {"Key": "Name", "Value": "sub-test-chevauchement_bko"},
          {"Key": "Projet", "Value": "SatomCloudNetwork"},
          {"Key": "Equipe", "Value": {"Ref": "Equipe"}},
          {"Key": "Environnement", "Value": "prod"}
        ]
      }
    }
  }
}
