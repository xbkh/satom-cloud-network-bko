{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Satom Cloud Network - module 2, TP 2 et 3 - routage prive",
  "Parameters": {
    "Equipe": {
      "Type": "String",
      "MinLength": 1,
      "MaxLength": 128,
      "Description": "Nom de l equipe du cours"
    },
    "Ami": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    },
    "IpPoste": {
      "Type": "String",
      "Description": "IPv4 du poste de test au format CIDR /32",
      "AllowedPattern": "(\\d{1,3}\\.){3}\\d{1,3}/32"
    },
    "RoutePriveeActive": {
      "Type": "String",
      "AllowedValues": [
        "oui",
        "non"
      ],
      "Default": "oui"
    }
  },
  "Resources": {
    "VpcProd": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.0.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": "vpc-prod-leman_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      }
    },
    "SubnetPublic": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VpcProd"
        },
        "AvailabilityZone": "eu-north-1a",
        "CidrBlock": "10.0.1.0/24",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": "sub-public-1a_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      }
    },
    "SubnetPrive": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VpcProd"
        },
        "AvailabilityZone": "eu-north-1a",
        "CidrBlock": "10.0.2.0/24",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": "sub-prive-1a_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      }
    },
    "WebTestSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Module 1 ICMP Web",
        "VpcId": {
          "Ref": "VpcProd"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "sg-tp2-web_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ],
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": {
              "Ref": "IpPoste"
            },
            "Description": "SSH depuis le poste de TP"
          }
        ]
      }
    },
    "WebInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "Ami"
        },
        "InstanceType": "t3.micro",
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": false,
            "SubnetId": {
              "Ref": "SubnetPublic"
            },
            "PrivateIpAddress": "10.0.1.10",
            "GroupSet": [
              {
                "Ref": "WebTestSg"
              }
            ]
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required"
        },
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nexec >/dev/console 2>&1\nfor attempt in {1..20}; do\n  if ping -c 1 -W 2 10.0.2.10 >/dev/null; then break; fi\n  sleep 5\ndone\necho '=== TP2 web-01_bko ==='\nset -x\nping -c 4 -W 2 10.0.2.10\nstatus=$?\nset +x\necho \"=== TP2 web-01_bko exit=$status ===\"\n"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "web-01_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ],
        "PropagateTagsToVolumeOnCreation": true
      }
    },
    "AppTestSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Module 1 ICMP App",
        "VpcId": {
          "Ref": "VpcProd"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "sg-tp2-app_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ],
        "SecurityGroupIngress": [
          {
            "IpProtocol": "icmp",
            "FromPort": 8,
            "ToPort": -1,
            "SourceSecurityGroupId": {
              "Ref": "WebTestSg"
            }
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "SourceSecurityGroupId": {
              "Ref": "WebTestSg"
            },
            "Description": "SSH de test depuis web uniquement"
          }
        ]
      }
    },
    "AppInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "Ami"
        },
        "InstanceType": "t3.micro",
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": false,
            "SubnetId": {
              "Ref": "SubnetPrive"
            },
            "PrivateIpAddress": "10.0.2.10",
            "GroupSet": [
              {
                "Ref": "AppTestSg"
              }
            ]
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required"
        },
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nexec >/dev/console 2>&1\necho '=== TP2 app-01_bko ==='\nset -x\nping -c 4 -W 2 8.8.8.8\nstatus=$?\nset +x\necho \"=== TP2 app-01_bko exit=$status ===\"\n"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "app-01_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ],
        "PropagateTagsToVolumeOnCreation": true
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": "igw-prod-leman_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "VpcProd"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "RouteTablePublic": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VpcProd"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "rt-public-leman_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      }
    },
    "RoutePublicDefault": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTablePublic"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "RoutePublicAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetPublic"
        },
        "RouteTableId": {
          "Ref": "RouteTablePublic"
        }
      }
    },
    "WebEip": {
      "Type": "AWS::EC2::EIP",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "Name",
            "Value": "eip-web-01_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      }
    },
    "WebEipAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "WebEip",
            "AllocationId"
          ]
        },
        "InstanceId": {
          "Ref": "WebInstance"
        }
      }
    },
    "NatEip": {
      "Type": "AWS::EC2::EIP",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "Name",
            "Value": "eip-nat-leman_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      }
    },
    "NatGateway": {
      "Type": "AWS::EC2::NatGateway",
      "DependsOn": [
        "RoutePublicDefault",
        "RoutePublicAssociation"
      ],
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetPublic"
        },
        "AllocationId": {
          "Fn::GetAtt": [
            "NatEip",
            "AllocationId"
          ]
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "nat-prod-leman_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      }
    },
    "RouteTablePrivee": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VpcProd"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "rt-prive-leman_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      }
    },
    "RoutePriveeDefault": {
      "Type": "AWS::EC2::Route",
      "Condition": "AvecRoutePrivee",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTablePrivee"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "NatGateway"
        }
      }
    },
    "RoutePriveeAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetPrive"
        },
        "RouteTableId": {
          "Ref": "RouteTablePrivee"
        }
      }
    }
  },
  "Outputs": {
    "VpcProdId": {
      "Value": {
        "Ref": "VpcProd"
      }
    },
    "SubnetPublicId": {
      "Value": {
        "Ref": "SubnetPublic"
      }
    },
    "SubnetPriveId": {
      "Value": {
        "Ref": "SubnetPrive"
      }
    },
    "WebInstanceId": {
      "Value": {
        "Ref": "WebInstance"
      }
    },
    "AppInstanceId": {
      "Value": {
        "Ref": "AppInstance"
      }
    },
    "WebPublicIp": {
      "Value": {
        "Ref": "WebEip"
      }
    },
    "RouteTablePublicId": {
      "Value": {
        "Ref": "RouteTablePublic"
      }
    },
    "RouteTablePriveeId": {
      "Value": {
        "Ref": "RouteTablePrivee"
      }
    },
    "NatGatewayId": {
      "Value": {
        "Ref": "NatGateway"
      }
    }
  },
  "Conditions": {
    "AvecRoutePrivee": {
      "Fn::Equals": [
        {
          "Ref": "RoutePriveeActive"
        },
        "oui"
      ]
    }
  }
}
