{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Module 4 TP 3 - routage symetrique avec reutilisation de l EIP du NAT",
  "Parameters": {
    "Equipe": {
      "Type": "String",
      "MinLength": 1,
      "MaxLength": 128,
      "Description": "Nom de l equipe du cours"
    },
    "Ami": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    },
    "IpPoste": {
      "Type": "String",
      "Description": "IPv4 du poste de test au format CIDR /32",
      "AllowedPattern": "(\\d{1,3}\\.){3}\\d{1,3}/32"
    },
    "RoutePriveeActive": {
      "Type": "String",
      "AllowedValues": [
        "oui",
        "non"
      ],
      "Default": "oui"
    },
    "RetourHttps": {
      "Type": "String",
      "AllowedValues": [
        "oui",
        "non"
      ],
      "Default": "oui"
    },
    "AccesApp": {
      "Type": "String",
      "AllowedValues": [
        "oui",
        "non"
      ],
      "Default": "oui"
    },
    "RefusHttpsPrioritaire": {
      "Type": "String",
      "AllowedValues": [
        "oui",
        "non"
      ],
      "Default": "non"
    },
    "SousReseauFirewall": {
      "Type": "AWS::EC2::Subnet::Id",
      "Description": "Sous-reseau du pare-feu du TP 2"
    },
    "EndpointFirewall": {
      "Type": "String",
      "AllowedPattern": "vpce-[0-9a-f]+",
      "Description": "Identifiant de l endpoint du pare-feu a Stockholm a"
    },
    "ModeNat": {
      "Type": "String",
      "AllowedValues": [
        "reference",
        "preparation",
        "inspection"
      ],
      "Default": "reference"
    }
  },
  "Resources": {
    "VpcProd": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.0.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": "vpc-prod-leman_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      }
    },
    "SubnetPublic": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VpcProd"
        },
        "AvailabilityZone": "eu-north-1a",
        "CidrBlock": "10.0.1.0/24",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": "sub-public-1a_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      }
    },
    "SubnetPrive": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VpcProd"
        },
        "AvailabilityZone": "eu-north-1a",
        "CidrBlock": "10.0.2.0/24",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": "sub-prive-1a_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      }
    },
    "WebTestSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Module 1 ICMP Web",
        "VpcId": {
          "Ref": "VpcProd"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "sg-web_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ],
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": {
              "Ref": "IpPoste"
            }
          }
        ]
      }
    },
    "WebInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "Ami"
        },
        "InstanceType": "t3.micro",
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": false,
            "SubnetId": {
              "Ref": "SubnetPublic"
            },
            "PrivateIpAddress": "10.0.1.10",
            "GroupSet": [
              {
                "Ref": "WebTestSg"
              }
            ]
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required"
        },
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nexec >/dev/console 2>&1\nfor attempt in {1..20}; do\n  if ping -c 1 -W 2 10.0.2.10 >/dev/null; then break; fi\n  sleep 5\ndone\necho '=== TP2 web-01_bko ==='\nset -x\nping -c 4 -W 2 10.0.2.10\nstatus=$?\nset +x\necho \"=== TP2 web-01_bko exit=$status ===\"\n"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "web-01_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ],
        "PropagateTagsToVolumeOnCreation": true
      }
    },
    "AppTestSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Module 1 ICMP App",
        "VpcId": {
          "Ref": "VpcProd"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "sg-app_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ],
        "SecurityGroupIngress": [
          {
            "Fn::If": [
              "AvecAccesApp",
              {
                "IpProtocol": "tcp",
                "FromPort": 8080,
                "ToPort": 8080,
                "SourceSecurityGroupId": {
                  "Ref": "WebTestSg"
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "SourceSecurityGroupId": {
              "Ref": "WebTestSg"
            }
          }
        ]
      }
    },
    "AppInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "Ami"
        },
        "InstanceType": "t3.micro",
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": false,
            "SubnetId": {
              "Ref": "SubnetPrive"
            },
            "PrivateIpAddress": "10.0.2.10",
            "GroupSet": [
              {
                "Ref": "AppTestSg"
              }
            ]
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required"
        },
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nexec >/dev/console 2>&1\necho '=== TP2 app-01_bko ==='\nset -x\nping -c 4 -W 2 8.8.8.8\nstatus=$?\nset +x\necho \"=== TP2 app-01_bko exit=$status ===\"\n"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "app-01_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ],
        "PropagateTagsToVolumeOnCreation": true
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": "igw-prod-leman_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "VpcProd"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "RouteTablePublic": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VpcProd"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "rt-public-leman_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      }
    },
    "RoutePublicDefault": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTablePublic"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "RoutePublicAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetPublic"
        },
        "RouteTableId": {
          "Ref": "RouteTablePublic"
        }
      }
    },
    "WebEip": {
      "Type": "AWS::EC2::EIP",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "Name",
            "Value": "eip-web-01_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      }
    },
    "WebEipAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "WebEip",
            "AllocationId"
          ]
        },
        "InstanceId": {
          "Ref": "WebInstance"
        }
      }
    },
    "NatEip": {
      "Type": "AWS::EC2::EIP",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "Name",
            "Value": "eip-nat-leman_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      }
    },
    "NatGateway": {
      "Type": "AWS::EC2::NatGateway",
      "DependsOn": [
        "RoutePublicDefault",
        "RoutePublicAssociation"
      ],
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetPublic"
        },
        "AllocationId": {
          "Fn::GetAtt": [
            "NatEip",
            "AllocationId"
          ]
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "nat-prod-leman_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      },
      "Condition": "NatReference"
    },
    "RouteTablePrivee": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VpcProd"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "rt-prive-leman_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      }
    },
    "RoutePriveeDefault": {
      "Type": "AWS::EC2::Route",
      "Condition": "RoutePriveeReference",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTablePrivee"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "NatGateway"
        }
      }
    },
    "RoutePriveeAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetPrive"
        },
        "RouteTableId": {
          "Ref": "RouteTablePrivee"
        }
      }
    },
    "NaclPublic": {
      "Type": "AWS::EC2::NetworkAcl",
      "Properties": {
        "VpcId": {
          "Ref": "VpcProd"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "nacl-public_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      }
    },
    "DenyHttps": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "NaclPublic"
        },
        "RuleNumber": 90,
        "Protocol": 6,
        "CidrBlock": "0.0.0.0/0",
        "Egress": false,
        "RuleAction": "deny",
        "PortRange": {
          "From": 443,
          "To": 443
        }
      },
      "Condition": "AvecRefusHttps"
    },
    "InHttps": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "NaclPublic"
        },
        "RuleNumber": 100,
        "Protocol": 6,
        "CidrBlock": "0.0.0.0/0",
        "Egress": false,
        "RuleAction": "allow",
        "PortRange": {
          "From": 443,
          "To": 443
        }
      }
    },
    "InSsh": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "NaclPublic"
        },
        "RuleNumber": 110,
        "Protocol": 6,
        "CidrBlock": {
          "Ref": "IpPoste"
        },
        "Egress": false,
        "RuleAction": "allow",
        "PortRange": {
          "From": 22,
          "To": 22
        }
      }
    },
    "InEphemeral": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "NaclPublic"
        },
        "RuleNumber": 120,
        "Protocol": 6,
        "CidrBlock": "0.0.0.0/0",
        "Egress": false,
        "RuleAction": "allow",
        "PortRange": {
          "From": 1024,
          "To": 65535
        }
      }
    },
    "InIcmpReply": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "NaclPublic"
        },
        "RuleNumber": 130,
        "Protocol": 1,
        "CidrBlock": "0.0.0.0/0",
        "Egress": false,
        "RuleAction": "allow",
        "Icmp": {
          "Type": 0,
          "Code": -1
        }
      }
    },
    "InAppHttp": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "NaclPublic"
        },
        "RuleNumber": 140,
        "Protocol": 6,
        "CidrBlock": "10.0.2.0/24",
        "Egress": false,
        "RuleAction": "allow",
        "PortRange": {
          "From": 80,
          "To": 80
        }
      }
    },
    "InAppIcmp": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "NaclPublic"
        },
        "RuleNumber": 150,
        "Protocol": 1,
        "CidrBlock": "10.0.2.0/24",
        "Egress": false,
        "RuleAction": "allow",
        "Icmp": {
          "Type": 8,
          "Code": -1
        }
      }
    },
    "OutSshReply": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "NaclPublic"
        },
        "RuleNumber": 95,
        "Protocol": 6,
        "CidrBlock": {
          "Ref": "IpPoste"
        },
        "Egress": true,
        "RuleAction": "allow",
        "PortRange": {
          "From": 1024,
          "To": 65535
        }
      }
    },
    "OutHttpsReply": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "NaclPublic"
        },
        "RuleNumber": 100,
        "Protocol": 6,
        "CidrBlock": "0.0.0.0/0",
        "Egress": true,
        "RuleAction": "allow",
        "PortRange": {
          "From": 1024,
          "To": 65535
        }
      },
      "Condition": "AvecRetourHttps"
    },
    "OutSshToApp": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "NaclPublic"
        },
        "RuleNumber": 110,
        "Protocol": 6,
        "CidrBlock": "10.0.2.0/24",
        "Egress": true,
        "RuleAction": "allow",
        "PortRange": {
          "From": 22,
          "To": 22
        }
      }
    },
    "OutAppHttp": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "NaclPublic"
        },
        "RuleNumber": 120,
        "Protocol": 6,
        "CidrBlock": "10.0.2.0/24",
        "Egress": true,
        "RuleAction": "allow",
        "PortRange": {
          "From": 8080,
          "To": 8080
        }
      }
    },
    "OutHttp": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "NaclPublic"
        },
        "RuleNumber": 130,
        "Protocol": 6,
        "CidrBlock": "0.0.0.0/0",
        "Egress": true,
        "RuleAction": "allow",
        "PortRange": {
          "From": 80,
          "To": 80
        }
      }
    },
    "OutHttps": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "NaclPublic"
        },
        "RuleNumber": 140,
        "Protocol": 6,
        "CidrBlock": "0.0.0.0/0",
        "Egress": true,
        "RuleAction": "allow",
        "PortRange": {
          "From": 443,
          "To": 443
        }
      }
    },
    "OutIcmp": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "NaclPublic"
        },
        "RuleNumber": 150,
        "Protocol": 1,
        "CidrBlock": "0.0.0.0/0",
        "Egress": true,
        "RuleAction": "allow",
        "Icmp": {
          "Type": 8,
          "Code": -1
        }
      }
    },
    "OutIcmpReply": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "NaclPublic"
        },
        "RuleNumber": 160,
        "Protocol": 1,
        "CidrBlock": "10.0.2.0/24",
        "Egress": true,
        "RuleAction": "allow",
        "Icmp": {
          "Type": 0,
          "Code": -1
        }
      }
    },
    "NaclPublicAssociation": {
      "Type": "AWS::EC2::SubnetNetworkAclAssociation",
      "DependsOn": [
        "InHttps",
        "InSsh",
        "InEphemeral",
        "InIcmpReply",
        "InAppHttp",
        "InAppIcmp",
        "OutSshReply",
        "OutSshToApp",
        "OutAppHttp",
        "OutHttp",
        "OutHttps",
        "OutIcmp",
        "OutIcmpReply"
      ],
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetPublic"
        },
        "NetworkAclId": {
          "Ref": "NaclPublic"
        }
      }
    },
    "SubnetNatInspection": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VpcProd"
        },
        "CidrBlock": "10.0.5.0/28",
        "AvailabilityZone": "eu-north-1a",
        "Tags": [
          {
            "Key": "Name",
            "Value": "sub-nat-inspection_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "prod"
          }
        ]
      },
      "Condition": "NatInspectionActif"
    },
    "TableNatInspection": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VpcProd"
        },
        "Tags": [
