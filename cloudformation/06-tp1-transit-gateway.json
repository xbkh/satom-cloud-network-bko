{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Module 6, TP 1 - Transit Gateway et attachements",
  "Parameters": {
    "Equipe": {
      "Type": "String",
      "MinLength": 1
    },
    "VpcProd": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "SubnetProd": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "VpcDev": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "SubnetDev": {
      "Type": "AWS::EC2::Subnet::Id"
    }
  },
  "Resources": {
    "Tgw": {
      "Type": "AWS::EC2::TransitGateway",
      "Properties": {
        "AmazonSideAsn": 64512,
        "DefaultRouteTableAssociation": "disable",
        "DefaultRouteTablePropagation": "disable",
        "AutoAcceptSharedAttachments": "disable",
        "Tags": [
          {
            "Key": "Name",
            "Value": "tgw-leman_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "lab"
          }
        ]
      }
    },
    "AttProd": {
      "Type": "AWS::EC2::TransitGatewayAttachment",
      "Properties": {
        "TransitGatewayId": {
          "Ref": "Tgw"
        },
        "VpcId": {
          "Ref": "VpcProd"
        },
        "SubnetIds": [
          {
            "Ref": "SubnetProd"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "tgwa-prod_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "lab"
          }
        ]
      }
    },
    "AttDev": {
      "Type": "AWS::EC2::TransitGatewayAttachment",
      "Properties": {
        "TransitGatewayId": {
          "Ref": "Tgw"
        },
        "VpcId": {
          "Ref": "VpcDev"
        },
        "SubnetIds": [
          {
            "Ref": "SubnetDev"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "tgwa-dev_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "lab"
          }
        ]
      }
    }
  },
  "Outputs": {
    "TgwId": {
      "Value": {
        "Ref": "Tgw"
      }
    },
    "AttProdId": {
      "Value": {
        "Ref": "AttProd"
      }
    },
    "AttDevId": {
      "Value": {
        "Ref": "AttDev"
      }
    }
  }
}
