{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Module 6 - environnement dev et regle applicative sans peering",
  "Parameters": {
    "Equipe": {
      "Type": "String",
      "MinLength": 1
    },
    "Ami": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    },
    "GroupeApp": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    }
  },
  "Resources": {
    "VpcDev": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.1.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": "vpc-dev-leman_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "dev"
          }
        ]
      }
    },
    "SubnetDev": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VpcDev"
        },
        "CidrBlock": "10.1.1.0/24",
        "AvailabilityZone": "eu-north-1a",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": "sub-dev-1a_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "dev"
          }
        ]
      }
    },
    "TableDev": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VpcDev"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "rt-dev-leman_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "dev"
          }
        ]
      }
    },
    "AssociationDev": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetDev"
        },
        "RouteTableId": {
          "Ref": "TableDev"
        }
      }
    },
    "GroupeDev": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "VpcDev"
        },
        "GroupDescription": "Sortie applicative du lab vers app-01",
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "CidrIp": "10.0.2.10/32"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "sg-dev-leman_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "dev"
          }
        ]
      }
    },
    "InstanceDev": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "Ami"
        },
        "InstanceType": "t3.micro",
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": false,
            "SubnetId": {
              "Ref": "SubnetDev"
            },
            "PrivateIpAddress": "10.1.1.10",
            "GroupSet": [
              {
                "Ref": "GroupeDev"
              }
            ]
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required"
        },
        "UserData": {
          "Fn::Base64": "#cloud-boothook\n#!/bin/bash\ncat >/run/leman-tgw-test.sh <<'SCRIPT'\n#!/bin/bash\nexec >/dev/console 2>&1\nprevious=initial\ndeadline=$((SECONDS + 1200))\nwhile (( SECONDS < deadline )); do\n    response=$(curl --noproxy '*' -fsS --max-time 4 http://10.0.2.10:8080/ 2>&1)\n    result=$?\n    if [[ \"$result\" != \"$previous\" ]]; then\n        printf '=== TP6 %s dev-01_bko ===\\n' \"$(date -u +%FT%TZ)\"\n        echo '+ curl --noproxy \"*\" -fsS --max-time 4 http://10.0.2.10:8080/'\n        printf '%s\\n' \"$response\"\n        printf 'Code curl = %s\\n' \"$result\"\n        previous=$result\n    fi\n    sleep 5\ndone\nSCRIPT\nsystemd-run --unit=leman-tgw-test /bin/bash /run/leman-tgw-test.sh\n"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "dev-01_bko"
          },
          {
            "Key": "Projet",
            "Value": "SatomCloudNetwork"
          },
          {
            "Key": "Equipe",
            "Value": {
              "Ref": "Equipe"
            }
          },
          {
            "Key": "Environnement",
            "Value": "dev"
          }
        ],
        "PropagateTagsToVolumeOnCreation": true
      }
    },
    "AppDepuisDev": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "GroupeApp"
        },
        "IpProtocol": "tcp",
        "FromPort": 8080,
        "ToPort": 8080,
        "CidrIp": "10.1.0.0/16",
        "Description": "TP peering developpement"
      }
    }
  },
  "Outputs": {
    "VpcDevId": {
      "Value": {
        "Ref": "VpcDev"
      }
    },
    "SubnetDevId": {
      "Value": {
        "Ref": "SubnetDev"
      }
    },
    "TableDevId": {
      "Value": {
        "Ref": "TableDev"
      }
    },
    "InstanceDevId": {
      "Value": {
        "Ref": "InstanceDev"
      }
    }
  }
}
